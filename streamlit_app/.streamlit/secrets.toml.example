# Copy to streamlit_app/.streamlit/secrets.toml and fill in.
#
# Use each Supabase project's "Session pooler" connection string
# (Supabase Dashboard -> Connect -> Session pooler, port 5432).
# The +psycopg2 driver prefix is required for SQLAlchemy.

# --- Single project -------------------------------------------------
# Just define one connection named "supabase" and skip [projects].

[connections.supabase]
url = "postgresql+psycopg2://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres"


# --- Multiple projects, one website ------------------------------------
# Add a [projects] table (display name -> connection name) plus a
# [connections.<name>] block per Supabase database. The sign-in screen
# then shows a "Project" dropdown, and every query/auth check runs
# against the chosen project's database (its own user_credentials).
#
# [projects]
# "PM0045 - Prefchem UG" = "supabase"
# "PM0100 - Next Job"     = "supabase_pm0100"
#
# [connections.supabase_pm0100]
# url = "postgresql+psycopg2://postgres.OTHER-REF:OTHER-PW@aws-0-REGION.pooler.supabase.com:5432/postgres"
